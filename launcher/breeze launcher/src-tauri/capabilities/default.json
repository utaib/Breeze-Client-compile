{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The launcher window. Grants each Breeze command to the local app origin only, so ad frames and remote pages cannot call them.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-url",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME/.breezeclient/**"
        }
      ]
    },
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [
        {
          "path": "$HOME/.breezeclient/**"
        }
      ]
    },
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-set-focus",
    "allow-launcher-manifest",
    "allow-list-installed-mods",
    "allow-scan-instance-mods",
    "allow-remove-mod-file",
    "allow-open-instance-folder",
    "allow-list-mod-versions",
    "allow-stage-mod-version",
    "allow-apply-mod-change",
    "allow-discard-mod-change",
    "allow-list-mod-backups",
    "allow-restore-mod-backup",
    "allow-install-modrinth-mod",
    "allow-import-custom-mod",
    "allow-set-mod-enabled",
    "allow-remove-installed-mod",
    "allow-copy-local-mod-to-profile",
    "allow-list-installed-packs",
    "allow-list-pack-library",
    "allow-use-library-pack",
    "allow-download-modrinth-pack",
    "allow-import-custom-pack",
    "allow-set-pack-state",
    "allow-remove-installed-pack",
    "allow-prepare-local-server",
    "allow-import-local-server-file",
    "allow-start-local-server",
    "allow-stop-local-server",
    "allow-read-local-server-log",
    "allow-get-launcher-settings",
    "allow-update-launcher-settings",
    "allow-import-feather-preferences",
    "allow-import-lunar-preferences",
    "allow-import-client-mods",
    "allow-import-badlion-preferences",
    "allow-import-vanilla-preferences",
    "allow-import-modrinth-app-preferences",
    "allow-import-mrpack",
    "allow-export-mrpack",
    "allow-stage-import-chunk",
    "allow-clear-staged-import",
    "allow-detect-importable-clients",
    "allow-import-everything",
    "allow-apply-performance-profile",
    "allow-prewarm-version",
    "allow-get-system-memory-info",
    "allow-begin-microsoft-auth",
    "allow-restore-saved-session",
    "allow-clear-saved-session",
    "allow-save-custom-background",
    "allow-save-custom-background-staged",
    "allow-load-custom-background",
    "allow-discord-set-presence",
    "allow-discord-clear-presence",
    "allow-clear-custom-background",
    "allow-list-saved-accounts",
    "allow-switch-account",
    "allow-remove-saved-account",
    "allow-sign-out-all-accounts",
    "allow-prepare-launch",
    "allow-launch-minecraft",
    "allow-ensure-java-runtime",
    "allow-get-java-runtime-status",
    "allow-download-and-install-update",
    "allow-get-platform",
    "allow-get-version-compatibility",
    "allow-get-recordings-dir"
  ]
}
