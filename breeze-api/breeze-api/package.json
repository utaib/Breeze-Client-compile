    "verify:roles": "node scripts/verify-roles.cjs",
    "verify:spotify": "node scripts/verify-spotify.cjs",
    "verify:release": "node scripts/verify-release.cjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@supabase/supabase-js": "^2.109.0",
    "axios": "^1.19.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "fflate": "^0.8.3",
    "helmet": "^7.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.10.1",
    "sharp": "^0.35.3",
    "uuid": "^9.0.1",
    "ws": "^8.21.1"
