{
  "name": "breeze-api",
  "version": "1.1.0",
  "description": "Breeze Client Backend API",
  "main": "server.js",
  "scripts": {
    "start": "bash scripts/ensure-nginx-upload-limit.sh || true; node server.js",
    "dev": "nodemon server.js",
    "test": "node --test \"test/**/*.test.cjs\"",
    "nginx:ensure": "bash scripts/ensure-nginx-upload-limit.sh",
